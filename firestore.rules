rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: is the caller authenticated?
    function isAuth() {
      return request.auth != null;
    }
    
    // Helper: is the caller the owner of this user document?
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    // Helper: is the caller an admin? (uses Custom Claims)
    function isAdmin() {
      return isAuth() && request.auth.token.admin == true;
    }
    
    // Helper: allowed fields on user document creation (registration)
    function allowedUserCreateFields() {
      return [
        'firstName', 'lastName', 'username', 'displayName', 'email',
        'photoURL', 'avatarUrl', 'avatarColor', 'bio', 'occupation', 'location',
        'githubUrl', 'linkedinUrl', 'telegramUrl', 'websiteUrl', 'locale', 'theme',
        'notificationSettings', 'targetHoursPerWeek', 'activeCoursesCount',
        'hoursLearned', 'certificatesCount', 'streakDays', 'lastActiveDate',
        'createdAt', 'referralCode', 'referredBy', 'selectedCourseId', 'selectedNodeId',
        'settings'
      ];
    }

    // Helper: allowed fields on user document update (Settings / Profile edit)
    // Progress fields (streakDays, hoursLearned, certificatesCount, activeCoursesCount)
    // and immutable fields (createdAt, referralCode, referredBy) are excluded from client updates.
    function allowedUserUpdateFields() {
      return [
        'firstName', 'lastName', 'username', 'displayName', 'email',
        'photoURL', 'avatarUrl', 'avatarColor', 'bio', 'occupation', 'location',
        'githubUrl', 'linkedinUrl', 'telegramUrl', 'websiteUrl', 'locale', 'theme',
        'notificationSettings', 'targetHoursPerWeek', 'selectedCourseId', 'selectedNodeId',
        'settings', 'lastActiveDate'
      ];
    }

    // --- Users ---
    match /users/{userId} {
      // User can read own profile; admins can read any; referrer can read referred users
      allow read: if isOwner(userId) || isAdmin() || (isAuth() && resource.data.referredBy == request.auth.uid);
      
      // User can update own profile ONLY for whitelisted profile/settings fields
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedUserUpdateFields());
      
      // User doc creation only for whitelisted initial registration fields
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(allowedUserCreateFields());
      
      // Delete only by admin or through Cloud Function
      allow delete: if isAdmin();
      
      // --- Subscription subcollection ---
      match /subscription/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        // Writes only through Cloud Functions (after payment verification)
        allow write: if false;
      }
      
      // --- Achievements subcollection ---
      match /achievements/{achievementId} {
        allow read: if isOwner(userId) || isAdmin();
        // Writes should come from Cloud Functions after server-side validation
        allow write: if false;
      }
      
      // --- Quiz Results ---
      // Writes only through Cloud Function (submitQuizResult) after server-side evaluation
      match /quizResults/{quizId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      // --- Homework Submissions ---
      match /homeworkSubmissions/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      // --- Activities ---
      match /activities/{activityId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if isAdmin();
      }
      
      // --- Notifications ---
      match /notifications/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      // --- Resource Ratings subcollection ---
      match /resourceRatings/{resourceId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      // --- Mentor Sessions ---
      match /mentorSessions/{sessionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // --- Flashcards subcollection ---
      match /flashcards/{cardId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // --- Courses ---
    match /courses/{courseId} {
      // Owner can write their own courses, but anyone authenticated can read if they have the ID (needed for group lessons)
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // --- Course Templates Cache ---
    match /courseTemplates/{templateId} {
      allow read: if isAuth();
      allow create, update: if isAuth()
        && (!('title' in request.resource.data) || request.resource.data.title is string);
      
      match /lessons/{lessonId} {
        allow read, write: if isAuth();
      }
    }
    
    // --- Settings (admin-only) ---
    match /settings/{docId} {
      allow read: if true; // maintenance status, legal docs are public
      allow write: if isAdmin();
    }
    
    // --- Support Tickets ---
    match /support_tickets/{ticketId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      
      match /messages/{messageId} {
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid || isAdmin()
        );
        allow create: if isAuth() && (
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid || isAdmin()
        );
        allow update, delete: if isAuth() && (
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid || isAdmin()
        );
      }
    }
    
    // --- Promocodes ---
    match /promocodes/{promoCodeId} {
      // Anyone authenticated can read a specific promocode to validate it
      allow read: if isAuth();
      // Only admins can create, update, or delete promocodes
      allow write: if isAdmin();
    }
    
    // --- Legacy quizResults root collection ---
    match /quizResults/{docId} {
      allow read, delete: if isAuth() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if false; // Migration only
    }
    
    // --- Certificates ---
    match /certificates/{certId} {
      // Certificates verification is public (anyone can verify by certId)
      allow read: if true;
      // Allow authenticated user to create certificate ONLY IF they own the course and course progress is 100%
      allow create: if isAuth() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'courseId', 'certId'])
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.progress == 100;
      // Certificates are immutable: cannot be modified or deleted by clients
      allow update, delete: if false;
    }

    // --- Resource Ratings Aggregated ---
    match /resourceRatingsAggregated/{resourceId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // --- Admin Notifications ---
    match /admin_notifications/{docId} {
      allow read, write: if isAdmin();
    }

    match /groups/{groupId} {
      allow read: if isAuth() && (
        request.auth.uid in resource.data.members.keys() || 
        (resource.data.invitedUserIds != null && request.auth.uid in resource.data.invitedUserIds) ||
        isAdmin()
      );
      // Group creation and general updates are via Cloud Functions.
      // Exception: Users can update their own rulesAccepted flag.
      allow update: if isAuth() 
        && request.auth.uid in resource.data.members.keys()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].diff(resource.data.members[request.auth.uid]).affectedKeys().hasOnly(['rulesAccepted', 'rulesAcceptedAt']);
      allow create: if false;
      allow delete: if isAdmin();
    }

    match /group_invitations/{invitationId} {
      allow read: if isAuth() && (
        resource.data.inviterId == request.auth.uid || 
        resource.data.inviteeId == request.auth.uid || 
        isAdmin()
      );
      allow create: if false;
      allow update: if isAuth() 
        && resource.data.inviteeId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined')
        && (resource.data.status == 'pending' || resource.data.status == request.resource.data.status)
        && (!("expiresAt" in resource.data) || resource.data.expiresAt > request.time);
    }

    match /group_chats/{groupId}/messages/{messageId} {
      allow read: if isAuth() && (
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members.keys()
      );
      allow create: if isAuth() 
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members.keys()
        && request.resource.data.senderId == request.auth.uid;
    }

    // --- Reviews ---
    match /reviews/{reviewId} {
      // Public can read published reviews; users can read their own; admins can read all
      allow read: if resource.data.status == 'published' || (isAuth() && (resource.data.userId == request.auth.uid || isAdmin()));
      
      // Authenticated user can submit a new review for moderation
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10;
        
      // Only admins can update review status (e.g. publish or hide)
      allow update: if isAdmin();
      
      // User can delete their own review only after moderation (status != 'new'); admin can delete any review
      allow delete: if isAuth() && ((resource.data.userId == request.auth.uid && resource.data.status != 'new') || isAdmin());
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
