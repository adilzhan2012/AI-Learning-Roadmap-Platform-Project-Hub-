rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile rules: Users can only read and write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Activity log rules: Users can only read and write their own activities
      match /activities/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Courses rules: Users can only read, update, or delete courses they own
    match /courses/{courseId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
