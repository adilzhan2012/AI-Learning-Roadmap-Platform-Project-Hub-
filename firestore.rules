rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: is the caller authenticated?
    function isAuth() {
      return request.auth != null;
    }
    
    // Helper: is the caller the owner of this user document?
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    // Helper: is the caller an admin? (uses Custom Claims)
    function isAdmin() {
      return isAuth() && request.auth.token.admin == true;
    }
    
    // --- Users ---
    match /users/{userId} {
      // User can read own profile; admins can read any
      allow read: if isOwner(userId) || isAdmin();
      
      // User can update own profile, but CANNOT change protected fields (role, subscription, XP, levels, etc.)
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'isAdmin', 'isPremium', 'isBanned', 'subscriptionPlan', 'xp', 'level', 'weeklyXP', 'totalXPEarned', 'xpHistory']);
      
      // User doc creation only during registration
      allow create: if isOwner(userId)
        && !request.resource.data.keys()
            .hasAny(['role', 'isAdmin', 'isPremium', 'isBanned', 'xp', 'level', 'weeklyXP', 'totalXPEarned', 'xpHistory']);
      
      // Delete only by admin or through Cloud Function
      allow delete: if isAdmin();
      
      // --- Subscription subcollection ---
      match /subscription/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        // Writes only through Cloud Functions (after payment verification)
        allow write: if false;
      }
      
      // --- Achievements subcollection ---
      match /achievements/{achievementId} {
        allow read: if isOwner(userId) || isAdmin();
        // Writes should come from Cloud Functions after server-side validation
        allow write: if false;
      }
      
      // --- Quiz Results ---
      match /quizResults/{quizId} {
        allow read: if isOwner(userId) || isAdmin();
        // Write allowed for the owner (quiz submission), but validate structure
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId;
      }
      
      // --- Activities ---
      match /activities/{activityId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if isAdmin();
      }
      
      // --- Mentor Sessions ---
      match /mentorSessions/{sessionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // --- Courses ---
    match /courses/{courseId} {
      // Owner can read/write their own courses
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
      
      // Allow reading courses for cloning (template courses with no userId or shared flag)
      allow read: if isAuth() && resource.data.isTemplate == true;
    }
    
    // --- Settings (admin-only) ---
    match /settings/{docId} {
      allow read: if true; // maintenance status, legal docs are public
      allow write: if isAdmin();
    }
    
    // --- Promocodes ---
    match /promocodes/{promoCodeId} {
      // Anyone authenticated can read a specific promocode to validate it
      allow read: if isAuth();
      // Only admins can create, update, or delete promocodes
      allow write: if isAdmin();
    }
    
    // --- Legacy quizResults root collection ---
    match /quizResults/{docId} {
      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow write: if false; // Migration only
    }
    
    // --- Certificates ---
    match /certificates/{certId} {
      // Certificates verification is public (anyone can verify by certId)
      allow read: if true;
      // Allow authenticated user to create certificate for themselves
      allow create: if isAuth() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'courseId', 'certId']);
      // Certificates are immutable: cannot be modified or deleted by clients
      allow update, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
